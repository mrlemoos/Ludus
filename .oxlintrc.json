{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "off"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "vitest",
    "promise",
    "node"
  ],
  "jsPlugins": ["./oxlint/ludus.js"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "worker-configuration.d.ts",
    "tests/fixtures",
    ".scratch",
    ".galicia",
    ".agents",
    ".claude",
    ".codex",
    ".cursor"
  ],
  "overrides": [
    {
      "files": [
        "src/cafe-environment.tsx",
        "src/board-3d.tsx",
        "src/table-clock.tsx",
        "src/chess-scene.tsx"
      ],
      "rules": {
        "react/no-unknown-property": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "tests/**",
        "**/*.test.ts",
        "playwright.config.ts",
        "vitest.config.ts",
        "vite.config.ts",
        "drizzle.config.ts"
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "node/no-process-env": "off",
        "node/no-sync": "off"
      }
    }
  ],
  "rules": {
    // Carve-outs stay off where a ban contradicts the React 19 runtime, named exports,
    // ref-as-prop rest, async workers, chess nulls, or relative imports, and where the
    // fixer rewrites assertions, await, Boolean(), querySelector, append, key order, or Vitest imports.
    "func-style": ["error", "declaration"],
    "id-length": "off",
    "no-magic-numbers": "off",
    "one-var": ["error", "never"],
    "sort-imports": ["error", { "ignoreDeclarationSort": true, "ignoreCase": false }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "react/function-component-definition": [
      "error",
      { "namedComponents": "function-declaration", "unnamedComponents": "arrow-function" }
    ],
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "react/jsx-max-depth": ["error", { "max": 8 }],
    "react/react-in-jsx-scope": "off",
    "react/forbid-component-props": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/promise-function-async": "off",
    "typescript/require-await": "off",
    "eslint/require-await": "off",
    "eslint/no-implicit-coercion": "off",
    "eslint/sort-keys": "off",
    "eslint/no-ternary": "off",
    "promise/prefer-await-to-then": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-dom-node-append": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-importing-vitest-globals": "off",
    "vitest/prefer-import-in-mock": "off",
    "vitest/consistent-test-it": ["error", { "fn": "it", "withinDescribe": "it" }],
    "eslint/no-undefined": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "as", "objectLiteralTypeAssertions": "allow" }
    ],
    "ludus/component-api": "error",
    "ludus/no-forward-ref": "error"
  }
}
