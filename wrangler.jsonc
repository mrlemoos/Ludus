{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludus",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ludus.mrlemoos.dev",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/@*",
      "/%40*",
      "/players/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemaps/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ludus",
      "database_id": "6d63a334-f31c-4266-aba9-12db26ad563e",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHES",
        "class_name": "Match"
      },
      {
        "name": "HUMAN_MATCHES",
        "class_name": "HumanMatch"
      },
      {
        "name": "MATCHMAKING",
        "class_name": "Matchmaking"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Match"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "HumanMatch",
        "Matchmaking"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  }
}
