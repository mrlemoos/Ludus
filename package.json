{
  "name": "ludus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm engine:prepare && vite --host 127.0.0.1",
    "build": "pnpm engine:prepare && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm seed && pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ludus --local",
    "db:migrate:remote": "wrangler d1 migrations apply ludus --remote",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy",
    "cf:types": "wrangler types --include-runtime false",
    "engine:prepare": "node scripts/prepare-engine.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-auth": "^1.7.14",
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0",
    "stockfish": "^19.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
